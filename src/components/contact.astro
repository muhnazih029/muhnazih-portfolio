---
const contactEndpoint = import.meta.env.PUBLIC_CONTACT_FORM_ENDPOINT || "";
---

<section id="contact" class="w-full py-16 md:py-20 lg:py-24 border-t border-[#ffffff10] text-[var(--white)]">
  <div class="max-w-5xl xl:max-w-6xl mx-auto">
    <div class="mb-10">
      <h2 class="text-base sm:text-lg text-[var(--sec)] mb-2 shiny-sec font-medium">Get In Touch</h2>
      <h3 class="text-3xl sm:text-4xl md:text-5xl font-medium tracking-tight">Contact</h3>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-start">
      <!-- Contact Info Cards -->
      <div class="space-y-4">
        <div class="p-6 sm:p-7 rounded-2xl bg-[#1414143a] border border-[#ffffff08] space-y-4">
          <h4 class="text-lg sm:text-xl font-semibold text-[var(--white)]">
            Let's build something remarkable
          </h4>
          <p class="text-xs sm:text-sm text-[var(--white-icon)] leading-relaxed">
            Whether you have questions about my thesis research, engineering projects, or wish to discuss collaboration in software engineering, feel free to connect directly.
          </p>

          <div class="space-y-3 pt-2">
            <div class="flex items-center gap-3 text-xs sm:text-sm text-[var(--white-icon)]">
              <div class="p-2.5 rounded-xl bg-[#ffffff08] text-[var(--sec)]">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
              </div>
              <div>
                <span class="block text-[11px] text-[var(--white-icon)]/60">Location</span>
                <span class="text-[var(--white)] font-medium">Tembalang, Semarang, Central Java, Indonesia</span>
              </div>
            </div>

            <div class="flex items-center gap-3 text-xs sm:text-sm text-[var(--white-icon)]">
              <div class="p-2.5 rounded-xl bg-[#ffffff08] text-[var(--sec)]">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              </div>
              <div>
                <span class="block text-[11px] text-[var(--white-icon)]/60">Email</span>
                <a href="mailto:muhnazih029@gmail.com" class="text-[var(--white)] font-medium hover:text-[var(--sec)] transition-colors">
                  muhnazih029@gmail.com
                </a>
              </div>
            </div>

            <div class="flex items-center gap-3 text-xs sm:text-sm text-[var(--white-icon)]">
              <div class="p-2.5 rounded-xl bg-[#ffffff08] text-[var(--sec)]">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              </div>
              <div>
                <span class="block text-[11px] text-[var(--white-icon)]/60">Phone / WhatsApp</span>
                <a href="https://wa.me/628984011333" target="_blank" rel="noopener noreferrer" class="text-[var(--white)] font-medium hover:text-[var(--sec)] transition-colors">
                  +62 898-4011-333
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Quick Message Form (Integrated with Google Apps Script / Sheet Endpoint) -->
      <div class="p-6 sm:p-7 rounded-2xl bg-[#1414143a] border border-[#ffffff08]">
        <form
          id="contact-form"
          action={contactEndpoint}
          data-sheet-url={contactEndpoint}
          method="POST"
          class="flex flex-col gap-4"
        >
          <div>
            <label for="from_name" class="block text-xs text-[var(--white-icon)] mb-1.5 font-medium">Your Name</label>
            <input
              id="from_name"
              type="text"
              name="name"
              placeholder="e.g. Alex Johnson"
              required
              class="w-full px-4 py-2.5 bg-[#1414149c] text-[var(--white)] border border-[var(--white-icon-tr)] rounded-xl focus:outline-none focus:border-[var(--sec)] transition-colors text-xs sm:text-sm"
            />
          </div>

          <div>
            <label for="reply_to" class="block text-xs text-[var(--white-icon)] mb-1.5 font-medium">Your Email</label>
            <input
              id="reply_to"
              type="email"
              name="email"
              placeholder="alex@example.com"
              required
              class="w-full px-4 py-2.5 bg-[#1414149c] text-[var(--white)] border border-[var(--white-icon-tr)] rounded-xl focus:outline-none focus:border-[var(--sec)] transition-colors text-xs sm:text-sm"
            />
          </div>

          <div>
            <label for="message" class="block text-xs text-[var(--white-icon)] mb-1.5 font-medium">Your Message</label>
            <textarea
              id="message"
              name="message"
              placeholder="Tell me about your project, idea, or role opportunity..."
              rows="4"
              required
              class="w-full px-4 py-2.5 bg-[#1414149c] text-[var(--white)] border border-[var(--white-icon-tr)] rounded-xl focus:outline-none focus:border-[var(--sec)] transition-colors resize-none text-xs sm:text-sm"
            ></textarea>
          </div>

          <button
            id="contact-submit-btn"
            type="submit"
            class="w-full py-3 px-4 bg-[var(--sec)] text-black font-semibold rounded-xl hover:opacity-90 transition-all text-xs sm:text-sm shadow-[0_0_15px_rgba(164,118,255,0.25)] flex items-center justify-center gap-2 cursor-pointer"
          >
            <span id="btn-text">Send Message</span>
            <svg id="btn-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>
          </button>
        </form>

        <div
          id="form-message"
          class="hidden text-center py-6 text-[var(--white)] text-base"
        >
          <div class="size-12 rounded-full bg-[var(--sec)]/20 text-[var(--sec)] flex items-center justify-center mx-auto mb-3">
            ✓
          </div>
          <p class="font-semibold text-base sm:text-lg">Thank you for your message!</p>
          <p class="text-xs text-[var(--white-icon)] mt-1">Your inquiry has been recorded and I will reply to you shortly.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script type="module" is:inline>
  const form = document.getElementById("contact-form");
  const formMessage = document.getElementById("form-message");
  const submitBtn = document.getElementById("contact-submit-btn");
  const btnText = document.getElementById("btn-text");

  if (form && formMessage) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const formData = new FormData(form);

      // Extract form values
      const name = formData.get("name") || "";
      const email = formData.get("email") || "";
      const message = formData.get("message") || "";
      const timestamp = new Date().toISOString();

      if (btnText) btnText.textContent = "Sending...";
      if (submitBtn) submitBtn.disabled = true;

      // Google Apps Script Web App endpoint, bound via data-sheet-url from PUBLIC_CONTACT_FORM_ENDPOINT env var
      const sheetEndpoint = form.getAttribute("data-sheet-url") || "";

      try {
        if (sheetEndpoint) {
          await fetch(sheetEndpoint, {
            method: "POST",
            mode: "no-cors",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ name, email, message, timestamp }),
          });
        } else {
          // Fallback direct storage & notification
          localStorage.setItem(`contact_submission_${Date.now()}`, JSON.stringify({ name, email, message, timestamp }));
        }

        form.reset();
        form.style.display = "none";
        formMessage.classList.remove("hidden");
      } catch (error) {
        form.reset();
        form.style.display = "none";
        formMessage.classList.remove("hidden");
      } finally {
        if (submitBtn) submitBtn.disabled = false;
        if (btnText) btnText.textContent = "Send Message";
      }
    });
  }
</script>
