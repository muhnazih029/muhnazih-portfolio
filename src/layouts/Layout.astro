---
interface Props {
  title: string;
}

const { title } = Astro.props;
const siteUrl = "https://muhnazih.azdastudio.my.id/";
const baseUrl = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <title>{title} | Software Developer & Cloud Infrastructure</title>
    <meta
      name="description"
      content="Muhammad Nazih - Informatics & Computer Engineering graduate and Software Developer specializing in fullstack web architecture, GCP cloud computing, and DevOps systems."
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#101010" />
    <meta name="color-scheme" content="dark" />
    <meta name="robots" content="index, follow" />

    <link rel="icon" type="image/svg+xml" href={`${baseUrl}/favicon.svg`} />
    <link rel="canonical" href={siteUrl} />

    <link
      rel="preload"
      href={`${baseUrl}/fonts/montserrat-latin-wght-normal.woff2`}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />

    <meta
      property="og:title"
      content="Muhammad Nazih | Software Developer & Cloud Infrastructure"
    />
    <meta
      property="og:description"
      content="Portfolio of Muhammad Nazih, Software Developer specializing in web applications, GCP cloud computing, and DevOps."
    />
    <meta
      property="og:image"
      content={`${siteUrl}og-images.svg`}
    />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:type" content="website" />
    <meta
      property="og:site_name"
      content="Muhammad Nazih Portfolio"
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Muhammad Nazih | Software Developer" />
    <meta name="twitter:description" content="Informatics and Computer Engineering graduate passionate about building robust software and cloud systems." />
    <meta name="twitter:image" content={`${siteUrl}og-images.svg`} />

    <!-- Structured Data (JSON-LD) for Schema.org / SEO -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Muhammad Nazih",
        "url": "https://muhnazih.azdastudio.my.id",
        "image": "https://muhnazih.azdastudio.my.id/og-images.svg",
        "sameAs": [
          "https://github.com/muhnazih029",
          "https://linkedin.com/in/muhnazih029"
        ],
        "jobTitle": "Software Developer",
        "alumniOf": {
          "@type": "CollegeOrUniversity",
          "name": "Universitas Negeri Semarang"
        },
        "knowsAbout": [
          "Software Engineering",
          "Fullstack Web Development",
          "Google Cloud Platform",
          "DevOps",
          "Linux",
          "RESTful APIs"
        ],
        "description": "Software Developer passionate about building robust software and cloud infrastructure."
      }
    </script>
  </head>
  <body class="bg-[--background] px-3 sm:px-6 md:px-10 lg:px-14 xl:px-20 max-w-[1920px] mx-auto overflow-x-hidden antialiased">
    <slot />
  </body>
</html>

<style is:global>
  @font-face {
    font-family: "Montserrat Variable";
    src: url("/fonts/montserrat-latin-wght-normal.woff2")
      format("woff2-variations");
    font-weight: 100 900;
    font-style: normal;
    font-display: swap;
  }

  :root {
    --background: #101010;
    --sec: #a476ff;
    --white: #dfdfdf;
    --white-icon: #f3f3f398;
    --white-icon-tr: #f3f3f310;
  }

  html {
    scroll-behavior: smooth;
  }

  * {
    font-family:
      "Montserrat Variable",
      -apple-system,
      system-ui,
      sans-serif;
    box-sizing: border-box;
    padding: 0;
    margin: 0;
  }

  *::selection {
    background-color: var(--sec);
    color: var(--background);
  }

  /* Scrollbar styles */
  ::-webkit-scrollbar {
    width: 8px;
  }

  ::-webkit-scrollbar-track {
    background: #101010;
  }

  ::-webkit-scrollbar-thumb {
    background: #262626;
    border-radius: 9999px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: var(--sec);
  }

  * {
    scrollbar-width: thin;
    scrollbar-color: #262626 #101010;
  }
</style>
